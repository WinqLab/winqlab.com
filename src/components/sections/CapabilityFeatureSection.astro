---
import type { Capability } from "../../data/capabilities";

interface Props {
  items: Capability[];
}

const { items } = Astro.props;
---

{
  items.map((item, index) => (
    <section class:list={["section-scene", index % 2 === 0 ? "section-scene--light" : "section-scene--white"]}>
      <div class="section-inner capability-feature">
        <div class="capability-feature__copy">
          <p class="eyebrow">{item.order}</p>
          <h2>{item.title}</h2>
          <p>{item.summary}</p>
          <a class="text-link" href={`/${item.slug}`}>进一步了解 {item.title}</a>
        </div>
        <div class="capability-feature__panel" aria-label={`${item.title}关注点`}>
          {item.focus.map((focus) => <span>{focus}</span>)}
        </div>
      </div>
    </section>
  ))
}
